---
layout: base.njk
permalink: /gallery/
title: "Photo Gallery | Gatorbacks Fishing Charters"
description: "Real photos from Gatorbacks charters in Tampa Bay & Kissimmee, with Capt. William Ashmore & the anglers who fished with him. See them & book a trip."
hero: boat-running-tampa-bay.jpg
breadcrumb: Gallery
---
{% import "partials.njk" as ui %}
<section class="hero hero--short">
  {% heroImage hero, "Center console fishing boat running across Tampa Bay", "35% 60%" %}
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="wrap hero__inner">
      <h1>Photo Gallery</h1>
    </div>
  </div>
</section>

<section class="lead-line">
  <div class="wrap wrap--narrow">
    <p>Real fish and real anglers, all from Gatorbacks trips. Tap any photo to see it bigger.</p>
    <div class="accent-bar accent-bar--center" aria-hidden="true"></div>
  </div>
</section>

{%- for group in gallery %}
<section class="gallery-group" id="{{ group.title | slugify }}">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ group.title }}</h2>
      {% if group.trip %}<a class="text-link" href="/charters/#{{ group.trip }}">See the {{ group.title.split(",")[0] | lower }} charter</a>{% endif %}
    </div>
    <div class="gallery-grid">
      {%- for photo in group.photos %}
      <button type="button" class="gallery-item" aria-label="Enlarge photo: {{ photo.alt }}">
        <img src="/images/{{ photo.src }}" alt="{{ photo.alt }}" sizes="(max-width: 699px) 50vw, 290px"{% if photo.pos %} style="object-position:{{ photo.pos }}"{% endif %}>
      </button>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endfor %}

<dialog class="lightbox" aria-label="Enlarged photo">
  <button type="button" class="lightbox__close" aria-label="Close">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#161616" stroke-width="2.6" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
  </button>
  <div class="lightbox__frame"></div>
  <p class="lightbox__caption"></p>
</dialog>

{{ ui.bookBand(site) }}

<script>
(function () {
  var dlg = document.querySelector(".lightbox");
  if (!dlg || !dlg.showModal) return;
  var frame = dlg.querySelector(".lightbox__frame"), cap = dlg.querySelector(".lightbox__caption");
  document.querySelectorAll(".gallery-item").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var pic = btn.querySelector("picture") || btn.querySelector("img");
      var copy = pic.cloneNode(true);
      copy.querySelectorAll("source,img").forEach(function (n) { n.setAttribute("sizes", "92vw"); });
      var img = copy.tagName === "IMG" ? copy : copy.querySelector("img");
      img.setAttribute("loading", "eager"); img.removeAttribute("width"); img.removeAttribute("height");
      frame.innerHTML = ""; frame.appendChild(copy);
      cap.textContent = img.getAttribute("alt") || "";
      dlg.showModal();
    });
  });
  dlg.querySelector(".lightbox__close").addEventListener("click", function () { dlg.close(); });
  dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
})();
</script>
