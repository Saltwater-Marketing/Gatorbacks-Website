---
layout: base.njk
permalink: /contact/
title: "Contact Gatorbacks Fishing Charters | Tampa Bay"
description: "Call or text Capt. William Ashmore at 813-714-5670 or send a message to plan a Tampa Bay or Kissimmee fishing trip. Book online anytime."
hero: dock-sunset-grouper-hogfish.jpg
breadcrumb: Contact
---
{% import "partials.njk" as ui %}
<section class="hero hero--short">
  {% heroImage hero, "Angler on the dock at sunset holding a red grouper and a hogfish", "50% 22%" %}
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="wrap hero__inner">
      <h1>Contact Gatorbacks Fishing Charters</h1>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap contact__grid">
    <div class="contact__info">
      <h2>Call or Text the Captain</h2>
      <p>The quickest way to plan a trip is a call or a text. Messages get answered once the captain is off the water.</p>
      <ul class="contact__list">
        <li><span class="contact__label">Call</span><a href="{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><span class="contact__label">Text</span><a href="{{ site.smsHref }}">{{ site.phone }}</a></li>
        <li><span class="contact__label">Email</span>{% if site.email | isPlaceholder %}<span>{{ site.email }}</span>{% else %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</li>
      </ul>
      <a class="social social--blue" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="{{ site.name }} on Facebook">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="#0070C0"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V9c0-.6.4-1 1-1z"/></svg>
      </a>
      <p class="contact__book">Already know your date? <a class="text-link" href="{{ site.bookUrl }}" target="_blank" rel="noopener">See the calendar and book online</a></p>
    </div>

    <form class="form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
      <h2>Send a Message</h2>
      <input type="hidden" name="form-name" value="contact">
      <p class="hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <div class="form__row">
        <label for="f-name">Name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="form__2">
        <div class="form__row">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required>
        </div>
        <div class="form__row">
          <label for="f-phone">Phone</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
        </div>
      </div>
      <div class="form__row">
        <label for="f-charter">Charter</label>
        <select id="f-charter" name="charter">
          <option value="">Not sure yet</option>
          {%- for t in trips %}
          <option>{{ t.name }}</option>
          {%- endfor %}
        </select>
      </div>
      <div class="form__2">
        <div class="form__row">
          <label for="f-date">Preferred date</label>
          <input id="f-date" name="date" type="date">
        </div>
        <div class="form__row">
          <label for="f-guests">Number of guests</label>
          <input id="f-guests" name="guests" type="number" min="1" max="6" inputmode="numeric">
        </div>
      </div>
      <div class="form__row">
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" rows="5"></textarea>
      </div>
      <div class="form__consent">
        <input id="f-sms" name="sms_consent" type="checkbox" value="yes">
        <label for="f-sms">By checking this box, I agree to receive text messages from Gatorbacks Fishing Charters about my trip request at the phone number above. Message frequency varies. Message and data rates may apply. Reply STOP to opt out or HELP for help. Consent is not a condition of booking.</label>
      </div>
      <button class="btn btn--blue" type="submit">Send Message</button>
    </form>
  </div>
</section>

<section class="map" aria-label="Map of Tampa Bay">
  <div class="wrap">
    <div class="map__frame" data-src="https://www.google.com/maps?q=Tampa+Bay,+Florida&amp;z=9&amp;output=embed">
      <p>Map of Tampa Bay. We'll confirm where to meet when you book.</p>
    </div>
  </div>
</section>

<script>
(function () {
  var box = document.querySelector(".map__frame");
  if (!box) return;
  function load() {
    var f = document.createElement("iframe");
    f.src = box.getAttribute("data-src"); f.title = "Map of Tampa Bay"; f.loading = "lazy";
    f.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
    box.innerHTML = ""; box.appendChild(f);
  }
  if (!("IntersectionObserver" in window)) return load();
  var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: "400px 0px" });
  io.observe(box);
})();
</script>
