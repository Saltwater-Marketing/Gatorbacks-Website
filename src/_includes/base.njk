<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/og-image.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0070C0">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/source-sans-3.woff2" as="font" type="font/woff2" crossorigin>
{% if hero %}{% heroPreload hero %}{% endif %}
<style>{{ css | safe }}</style>
{% include "tracking-head.njk" %}
{% if breadcrumb %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":{{ breadcrumb | json | safe }},"item":"{{ site.url }}{{ page.url }}"}]}
</script>
{% endif %}
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtmId }}" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
<a class="skip" href="#main">Skip to content</a>

<div class="topbar">
  <div class="wrap topbar__inner">
    <a href="{{ site.phoneHref }}">Call or text {{ site.phone }}</a>
  </div>
</div>

<header class="header">
  <div class="wrap header__inner">
    <a class="header__logo" href="/" aria-label="{{ site.name }} home">
      <img src="/images/logo-color.png" alt="{{ site.name }} logo" sizes="(max-width: 380px) 52px, (max-width: 899px) 62px, 92px" eleventy:widths="92,184,276" eleventy:formats="webp,png" loading="eager">
    </a>
    <nav class="header__nav" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <a class="btn btn--book header__book" href="{{ site.bookUrl }}" target="_blank" rel="noopener">{{ site.bookLabel }}</a>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <img class="footer__logo" src="/images/logo-white.png" alt="{{ site.name }} logo" sizes="98px" eleventy:widths="98,196,294" eleventy:formats="webp,png">
      <a class="social" href="{{ site.facebook }}" target="_blank" rel="noopener" aria-label="{{ site.name }} on Facebook">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V9c0-.6.4-1 1-1z"/></svg>
      </a>
    </div>
    <div>
      <p class="footer__label">Pages</p>
      <ul class="footer__links">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div>
      <p class="footer__label">Get in Touch</p>
      <p><a class="strong" href="{{ site.phoneHref }}">Call or text {{ site.phone }}</a></p>
      <p>Messages get answered once the captain is off the water.</p>
      <p><a href="{{ site.giftCardUrl }}" target="_blank" rel="noopener">Gift cards</a></p>
    </div>
  </div>
  <div class="footer__base">
    <div class="wrap footer__base-inner">
      <span>&copy; 2026 {{ site.name }}</span>
      <a href="https://www.saltwatermarketing.net/" target="_blank" rel="noopener">Website by Saltwater Marketing</a>
    </div>
  </div>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
