{#- Shared building blocks. Import with: {% import "partials.njk" as ui %} -#}

{% macro bookBand(site) %}
<section class="book-band" id="book">
  <img src="/images/group-dock-sunset-cooler.jpg" alt="" sizes="100vw" eleventy:widths="640,1024,1600" class="book-band__img">
  <div class="book-band__shade" aria-hidden="true"></div>
  <div class="book-band__body">
    <h2>Book Your Trip</h2>
    <p class="book-band__lead">Pick a date on our calendar and pay your deposit online.</p>
    <a class="btn btn--book btn--lg" href="{{ site.bookUrl }}" target="_blank" rel="noopener">{{ site.bookLabel }}</a>
    <p class="book-band__call">or call or text <a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
  </div>
</section>
{% endmacro %}

{% macro reviewsWidget(site) %}
<div class="reviews-widget" data-embed="{{ site.reviewsEmbed | urlencode }}">
  {% if not site.reviewsEmbed %}
  <a class="google-card" href="{{ site.googleReviewsUrl }}" target="_blank" rel="noopener">
    <svg class="google-card__logo" aria-hidden="true" width="44" height="44" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
    <span class="google-card__text">
      <span class="google-card__title">Google Reviews</span>
      <span>See what anglers say about their trips with Capt. Ashmore.</span>
    </span>
    <span class="google-card__link">Read reviews on Google <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
  </a>
  {% endif %}
</div>
{% endmacro %}

{% macro check() %}<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0070C0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>{% endmacro %}

{% macro wave(position) %}
{% if position == "top" %}
<svg class="wave" aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none"><path d="M0 30 C120 10 240 10 360 26 S600 44 720 26 S960 8 1080 24 S1320 42 1440 22 L1440 48 L0 48 Z" fill="#EAF3FB"/></svg>
{% else %}
<svg class="wave wave--bottom" aria-hidden="true" viewBox="0 0 1440 48" preserveAspectRatio="none"><path d="M0 18 C120 38 240 38 360 22 S600 4 720 22 S960 40 1080 24 S1320 6 1440 26 L1440 0 L0 0 Z" fill="#EAF3FB"/></svg>
{% endif %}
{% endmacro %}

{#- Loads the reviews embed only when it scrolls near (keeps it off the first paint). -#}
{% macro reviewsLoader() %}
<script>
(function () {
  var boxes = document.querySelectorAll(".reviews-widget[data-embed]");
  function load(el) {
    var html = decodeURIComponent(el.getAttribute("data-embed") || "");
    if (!html) return;
    el.removeAttribute("data-embed");
    var tpl = document.createElement("div"); tpl.innerHTML = html;
    Array.prototype.forEach.call(tpl.childNodes, function (n) {
      if (n.tagName === "SCRIPT") {
        var s = document.createElement("script");
        Array.prototype.forEach.call(n.attributes, function (a) { s.setAttribute(a.name, a.value); });
        s.text = n.text; el.appendChild(s);
      } else { el.appendChild(n.cloneNode(true)); }
    });
  }
  if (!("IntersectionObserver" in window)) { boxes.forEach(load); return; }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); load(e.target); } });
  }, { rootMargin: "600px 0px" });
  boxes.forEach(function (b) { io.observe(b); });
})();
</script>
{% endmacro %}
